# Copia a .env y ajusta. NUNCA subas el .env real a git.
PORT=3000

# Archivos JSON privados, relativos a server/. Respaldar junto a uploads/.
DATA_DIR=data
UPLOADS_DIR=uploads
# Copia pública para el frontend estático (vacío para desactivar).
STATIC_CLIENT_DIR=../client

# Repositorio público donde se sirve el portafolio. Solo se modifica gh-pages.
PAGES_REPOSITORY=iLestar/Portfolio

# Sesión del panel de administración
ADMIN_USER=
ADMIN_PASSWORD=cambia_esto
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Proveedor HTTP de traducción opcional. Vacío: completar el inglés en el panel.
TRANSLATE_URL=
# Solo para un proveedor que requiera clave:
TRANSLATE_API_KEY=
