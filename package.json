{
  "name": "lestar-portfolio",
  "private": true,
  "version": "0.1.0",
  "description": "Portafolio de Lestar — React, NestJS y almacenamiento JSON.",
  "scripts": {
    "test:images": "node --test scripts/optimize-images.test.mjs",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "test:pages": "node --test scripts/pages.test.mjs",
    "test:session": "node --test scripts/session.test.mjs",
    "check:api": "node scripts/check-api.mjs",
    "export:static": "node scripts/export-static.mjs",
    "init:data": "node scripts/init-data.mjs",
    "backup": "pwsh -NoProfile -File scripts/backup.ps1",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run start:dev"
  }
}
